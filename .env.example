# V2 Photographic Evidence & Object Storage Configuration
PHOTO_UPLOAD_ENABLED=false
PHOTO_PRESIGNED_EXPIRES_IN=300

# Primary Object Storage: AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=smart-citizen-evidence
# AWS_S3_ENDPOINT= # Optional override for S3-compatible local/testing endpoints

# Legacy Object Storage: Cloudflare R2 Configuration (Backward Compatibility Fallback)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Cloud Cost Governance & Safety Circuit Breaker Net
PHOTO_COST_GOVERNOR_ENABLED=true
PHOTO_MONTHLY_UPLOAD_LIMIT=1000
PHOTO_MONTHLY_STORAGE_LIMIT_MB=2048
PHOTO_DAILY_UPLOAD_LIMIT=200
PHOTO_MAX_UPLOADS_PER_USER=20
PHOTO_MAX_UPLOADS_PER_IP=30
PHOTO_CONSECUTIVE_FAILURES_THRESHOLD=5
